# Copy to .env.local for local dev, and add the same variable in
# Vercel → Project → Settings → Environment Variables for production.

# GoHighLevel inbound webhook that receives PPC funnel leads.
# In GHL: Automation → Workflows → new workflow → trigger "Inbound Webhook",
# copy the webhook URL it generates and paste it here.
# Without this set, /api/funnel-lead returns 500 and the form shows the
# call-us-instead fallback — leads are never silently dropped.
GHL_WEBHOOK_URL=
