# Copy to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# GoHighLevel Private Integration token used by /api/funnel-lead to create
# PPC funnel leads as contacts. Scopes: contacts.write + contacts.readonly.
# Without these set, /api/funnel-lead returns 500 and the form shows the
# call-us-instead fallback, so leads are never silently dropped.
GHL_API_TOKEN=
GHL_LOCATION_ID=
